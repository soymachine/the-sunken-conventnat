{
  "name": "the-sunken-covenant",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/version-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "npx firebase-tools emulators:start --only auth,database --project demo-sunken-covenant",
    "dev:emu": "VITE_FIREBASE_EMULATOR=1 vite",
    "deploy": "npm run build && npx firebase-tools deploy --only database,hosting"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
