{
  "name": "the-sunken-covenant",
  "private": true,
  "version": "0.41.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/compress-models.mjs && node tools/version-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "npx firebase-tools emulators:start --only auth,database --project demo-sunken-covenant",
    "dev:emu": "VITE_FIREBASE_EMULATOR=1 vite",
    "deploy": "npm run build && node tools/keep-previous-assets.mjs && npx -y firebase-tools@latest deploy --only hosting"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "firebase": "^13.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
