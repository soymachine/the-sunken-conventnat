# Copy to .env.local and fill in from the Firebase console (Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Set to 1 to use the local emulators instead (npm run emulators).
# VITE_FIREBASE_EMULATOR=1
