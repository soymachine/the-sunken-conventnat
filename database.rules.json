{
  "rules": {
    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid && !newData.child('guest').exists()",
          "guest": {
            ".write": "auth != null && !data.exists() && data.parent().child('host').exists() && newData.val() === auth.uid"
          },
          ".validate": "newData.hasChildren(['host', 'seed', 'mode', 'created']) && newData.child('created').val() <= now && newData.child('created').val() > now - 300000"
        },
        "log": {
          ".indexOn": [
            "ts"
          ],
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/host').val() === auth.uid || root.child('rooms').child($code).child('meta/guest').val() === auth.uid)",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && ((root.child('rooms').child($code).child('meta/host').val() === auth.uid && newData.child('by').val() === 0) || (root.child('rooms').child($code).child('meta/guest').val() === auth.uid && newData.child('by').val() === 1))"
          }
        },
        "presence": {
          ".read": "auth != null",
          "0": {
            ".write": "root.child('rooms').child($code).child('meta/host').val() === auth.uid"
          },
          "1": {
            ".write": "root.child('rooms').child($code).child('meta/guest').val() === auth.uid"
          }
        },
        ".write": "auth != null && !newData.exists() && ((data.child('done/0').val() === true && data.child('done/1').val() === true && (data.child('meta/host').val() === auth.uid || data.child('meta/guest').val() === auth.uid)) || data.child('meta/created').val() < now - 86400000)",
        "done": {
          ".read": "auth != null",
          "$seat": {
            ".write": "auth != null && (($seat === '0' && root.child('rooms').child($code).child('meta/host').val() === auth.uid) || ($seat === '1' && root.child('rooms').child($code).child('meta/guest').val() === auth.uid))",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "roomsByAge": {
      ".read": "auth != null",
      ".indexOn": [
        ".value"
      ],
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.isNumber() && newData.val() <= now && root.child('rooms').child($code).child('meta/host').val() === auth.uid) || (!newData.exists() && (!newData.parent().parent().child('rooms').child($code).exists() || data.val() < now - 86400000)))"
      }
    },
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "created": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "matches": {
          ".indexOn": [
            "at"
          ],
          "$m": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['at', 'vs', 'mode', 'result', 'rounds']) && newData.child('at').val() <= now && newData.child('at').val() > now - 60000",
            "vs": {
              ".validate": "newData.val() === 'machine' || newData.val() === 'online'"
            },
            "mode": {
              ".validate": "newData.val() === 'classic' || newData.val() === 'convoy'"
            },
            "result": {
              ".validate": "newData.val() === 'win' || newData.val() === 'loss'"
            },
            "role": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "opponent": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "cmd": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "foeCmd": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "reason": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "rounds": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
            },
            "shots": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2000"
            },
            "hits": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2000"
            },
            "sank": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
            },
            "lost": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
            },
            "krakens": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
            },
            "fair": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
